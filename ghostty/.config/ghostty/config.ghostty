theme= Catppuccin Frappe
background-opacity= 0.98
#fullscreen= true
window-height= 1080
window-width= 1080

# Keybinds

keybind= performable:ctrl+c=copy_to_clipboard:mixed
keybind= ctrl+v=paste_from_clipboard

keybind= ctrl+w=close_surface
keybind= ctrl+enter=new_split:right
keybind= ctrl+shift+enter=new_split:down
keybind= ctrl+alt+enter=toggle_fullscreen
keybind= ctrl+[=goto_split:previous
keybind= ctrl+]=goto_split:next
keybind= ctrl+arrow_up=resize_split:up,10
keybind= ctrl+arrow_down=resize_split:down,10
keybind= ctrl+arrow_left=resize_split:left,10
keybind= ctrl+arrow_right=resize_split:right,10

